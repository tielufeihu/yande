<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="game605.mapper.ImgTagMapper">

    <resultMap id="imgTagVO" type="game605.bean.vo.ImgTagVO">
        <result column="img_id" property="imgId"/>
        <result column="tag_id" property="tagId"/>
        <result column="tag_name" property="tagName"/>
    </resultMap>

    <select id="getImgTagVOByImgId" resultMap="imgTagVO">
        SELECT t1.*,t2.name as tag_name from img_tag t1
            left join tag t2 on t1.tag_id = t2.id where img_id = #{imgId}
    </select>


</mapper>
